generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ClimateReading {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())

  deviceId              String
  schoolId              String?
  community             String?

  temperatureC          Float?
  humidityPercent       Float?
  heatIndexC            Float?

  pm25                  Float?
  pm10                  Float?

  soilMoisturePercent   Float?
  rainfallMm            Float?

  batteryVoltage        Float?
  wifiRssi              Int?

  dhtHealthy            Boolean?
}
