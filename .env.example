DATABASE_URL=postgresql://postgres:postgres@localhost:5432/climasense
PORT=3000

# Production deployments must set a strong, unique API key and explicit origins.
API_KEY=replace-with-a-long-random-value
CORS_ORIGINS=http://localhost:3001

# Use mqtts:// with authenticated broker credentials in production.
MQTT_BROKER=mqtts://mqtt.example.com:8883
MQTT_TOPIC=climasense/example/readings
MQTT_USERNAME=replace-with-device-username
MQTT_PASSWORD=replace-with-device-password

# Local testing with mqtt:// requires an explicit opt-in.
MQTT_ALLOW_INSECURE=false
